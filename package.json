{
  "name": "@gms/tms",
  "version": "1.0.0",
  "description": "Tournament Management System (TMS) module for the Games Management System (GMS) \u2014 Kabaddi configuration",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node src/api/server.ts",
    "seed": "node src/seed/cli.ts",
    "demo": "node src/seed/cli.ts --reset && node src/api/server.ts",
    "test": "node --test --experimental-test-isolation=none test/",
    "typecheck": "tsc --noEmit",
    "test:ui": "node --test test/ui.smoke.test.ts"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  },
  "optionalDependencies": {}
}
